{
  "name": "susy-sass",
  "version": "2.4.0",
  "description": "Susy Sass power-tools for web layout updated to use SASS not node-sass. SASS will need to be installed in the core project",
  "author": "Darren Mackintosh <takuhii@gmail.com>",
  "main": "sass/_susy.scss",
  "sass": "sass/_susy.scss",
  "exports": {
    ".": "./sass/_susy.scss",
    "./modern": "./sass/_susy-modern.scss"
  },
  "files": [
    "sass",
    "eyeglass-exports.js",
    "README.md",
    "LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/takuhii/susy-sass.git"
  },
  "homepage": "https://github.com/takuhii/susy-sass#readme",
  "keywords": [
    "layout",
    "grid",
    "sass",
    "responsive",
    "rwd",
    "semantic",
    "eyeglass-module"
  ],
  "eyeglass": {
    "exports": "eyeglass-exports.js",
    "needs": "*"
  },
  "scripts": {
    "test": "node test-sass.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/takuhii/susy-sass/issues"
  },
  "devDependencies": {
    "sass": "^1.77.0",
    "sass-true": "5.0.0"
  }
}
